<?xml version="1.0" encoding="utf-8"?>
<!--
  steam_api(64).dll - the Steamworks proxy.

  It forwards to the real steamclient and nothing else. Every patch
  lives in kryotoO.dll; see core/kryotoo_abi.h for why. This project
  therefore links no hooking library at all.

  The four configurations used to be four copies of the same
  settings, with Debug defining NDEBUG, disabling debug libraries
  and turning on whole-program optimisation - a release build that
  wrote to a different folder, and two of the four ItemDefinitionGroups
  were duplicated outright. Shared settings are shared here, and the
  two configurations actually differ.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="dllmain.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="core\kryotoo_abi.h" />
    <ClInclude Include="include\kryotoo_host.h" />
    <ClInclude Include="include\globals.h" />
    <ClInclude Include="include\lobby_watch.h" />
    <ClInclude Include="include\kryoto_plugin.h" />
    <ClInclude Include="include\version.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="kryoto_online.rc">
      <AdditionalIncludeDirectories>$(ProjectDir)include</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{2D5F0675-9CC4-4337-B80E-6ECC2C3D4D11}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>kryoto_online</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <SpectreMitigation>false</SpectreMitigation>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Label="UserMacros" />

  <!--
    The filename IS the crack. A game loads this because it is called
    what Valve's is called, so the name is not cosmetic and must not
    drift.
  -->
  <PropertyGroup>
    <LinkIncremental>false</LinkIncremental>
    <TargetName Condition="'$(Platform)'=='x64'">steam_api64</TargetName>
    <TargetName Condition="'$(Platform)'=='Win32'">steam_api</TargetName>
    <ArchDir Condition="'$(Platform)'=='x64'">x64</ArchDir>
    <ArchDir Condition="'$(Platform)'=='Win32'">x86</ArchDir>
    <BuildRoot Condition="'$(Configuration)'=='Release'">relbuild</BuildRoot>
    <BuildRoot Condition="'$(Configuration)'=='Debug'">debbuild</BuildRoot>
    <OutDir>$(ProjectDir)$(BuildRoot)\$(ArchDir)\</OutDir>
    <IntDir>$(BuildRoot)\intermediate\$(ArchDir)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>
      </PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)include;$(ProjectDir)include\sdk;$(ProjectDir)include\api;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!--
        Statically linked CRT (see the RuntimeLibrary settings below):
        this file lands in a stranger's game folder, and a /MD build
        would demand a Visual C++ redistributable they do not have.
      -->
      <AdditionalDependencies>Shlwapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!--
    _DEBUG is what turns on the minidump handler in dllmain.cpp. It
    was never once defined, so the debug build shipped without the
    single feature that made it a debug build.
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- ProgramDatabase, not the Debug default Edit-and-Continue:
           /ZI and /guard:cf cannot both be on, and Control Flow Guard
           is worth more here than an edit-and-continue session on a
           DLL that only ever runs inside somebody else's game. -->
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>


  <!--
    rc.exe is not cl.exe: it predefines neither _WIN64 nor _M_AMD64, so a
    #ifdef on either is dead in a .rc file no matter which architecture is
    building. That is how the x64 build came to stamp itself
    OriginalFilename=steam_api.dll - the old IS_64BIT macro was never
    defined anywhere either. Pass it in by hand, and verify the stamp with
    `(Get-Item out.dll).VersionInfo` rather than trusting the #ifdef.
  -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ResourceCompile>
      <PreprocessorDefinitions>KRYOTOO_X64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
