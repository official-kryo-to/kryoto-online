#include <winver.h>
#include "../include/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION KRYOTOO_VERSION_MAJOR,KRYOTOO_VERSION_MINOR,KRYOTOO_VERSION_PATCH,0
 PRODUCTVERSION KRYOTOO_VERSION_MAJOR,KRYOTOO_VERSION_MINOR,KRYOTOO_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "kryo.to"
            VALUE "FileDescription", "KryotoOnline core"
            VALUE "FileVersion", KRYOTOO_VERSION_STR
            VALUE "InternalName", "kryotoO"
            VALUE "LegalCopyright", "kryo.to 2026"
            // Unlike the proxy beside it, this file is not pretending
            // to be anything - it is loaded by name, by us.
            #ifdef KRYOTOO_X64
            VALUE "OriginalFilename", "kryotoO.dll"
            #else
            VALUE "OriginalFilename", "kryotoO32.dll"
            #endif
            VALUE "ProductName", "kryoto-online"
            VALUE "ProductVersion", KRYOTOO_VERSION_STR
            VALUE "Comments", "https://kryo.to"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
