#include <winver.h>
#include "include/resource.h"

IDI_ICON1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,7,0,0
 PRODUCTVERSION 1,7,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "kryo.to"
            VALUE "FileDescription", "Steam Client API"
            VALUE "FileVersion", "1.7.0.0"
            VALUE "InternalName", "kryoto-online"
            VALUE "LegalCopyright", "kryo.to 2026"
            #ifdef IS_64BIT
            VALUE "OriginalFilename", "steam_api64.dll"
            #else
            VALUE "OriginalFilename", "steam_api.dll"
            #endif
            VALUE "ProductName", "kryoto-online"
            VALUE "ProductVersion", "1.7.0.0"
            VALUE "Comments", "https://kryo.to"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
