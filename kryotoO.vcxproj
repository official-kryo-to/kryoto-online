<?xml version="1.0" encoding="utf-8"?>
<!--
  kryotoO.dll - the patch core. See core/kryotoo_abi.h for why it is
  a separate DLL from steam_api(64).dll.

  TargetName differs by architecture on purpose: a game that ships
  both steam_api.dll and steam_api64.dll in one folder needs two
  cores in that folder, and one filename cannot be both.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="core\kryotoo_main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="core\kryotoo_abi.h" />
    <ClInclude Include="core\kryotoo_config.h" />
    <ClInclude Include="core\kryotoo_plugins.h" />
    <ClInclude Include="include\kryoto_plugin.h" />
    <ClInclude Include="include\version.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="core\kryotoo.rc" />
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{7F1B0C42-58A1-4E0B-9F3D-2C7A6B4E8D19}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>kryotoO</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <SpectreMitigation>false</SpectreMitigation>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Label="UserMacros" />

  <!-- x64 keeps the plain name; x86 carries the suffix. -->
  <PropertyGroup>
    <LinkIncremental>false</LinkIncremental>
    <TargetName Condition="'$(Platform)'=='x64'">kryotoO</TargetName>
    <TargetName Condition="'$(Platform)'=='Win32'">kryotoO32</TargetName>
    <ArchDir Condition="'$(Platform)'=='x64'">x64</ArchDir>
    <ArchDir Condition="'$(Platform)'=='Win32'">x86</ArchDir>
    <BuildRoot Condition="'$(Configuration)'=='Release'">relbuild</BuildRoot>
    <BuildRoot Condition="'$(Configuration)'=='Debug'">debbuild</BuildRoot>
    <OutDir>$(ProjectDir)$(BuildRoot)\$(ArchDir)\</OutDir>
    <IntDir>$(BuildRoot)\intermediate\kryotoO\$(ArchDir)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>
      </PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)include;$(ProjectDir)core;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>core\kryotoO.def</ModuleDefinitionFile>
      <AdditionalLibraryDirectories>$(ProjectDir)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!--
    Statically linked RELEASE CRT (/MT), in both configurations.

    Static because this DLL is dropped into a stranger's game folder,
    and a /MD build would need a Visual C++ redistributable the player
    does not have - the failure mode is the game refusing to start with
    a dialog naming a DLL nobody recognises.

    Release CRT even in Debug because lib/libMinHook.*.lib is a /MT
    build and there is no debug variant vendored. Building this one
    /MTd links LIBCMTD and LIBCMT into the same image (LNK4098), which
    is two CRTs with two heaps in one module - and this module hands
    allocations across to hooked code.

    Which is also why Debug here defines NDEBUG rather than _DEBUG.
    _DEBUG makes the CRT headers emit calls into the debug runtime
    (_CrtDbgReport and friends) that a /MT link cannot resolve, and
    nothing in this DLL is gated on _DEBUG anyway - the minidump
    handler that needs it lives in the proxy, which links no MinHook
    and does get a real /MTd debug build.

    So "Debug" here means a debuggable release: same CRT, same
    defines, but optimisation off and full PDBs.
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- ProgramDatabase, not the Debug default Edit-and-Continue:
           /ZI and /guard:cf cannot both be on, and Control Flow Guard
           is worth more here than an edit-and-continue session on a
           DLL that only ever runs inside somebody else's game. -->
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <!-- Not MultiThreadedDebug: see the comment above this group. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- MinHook is the only external dependency, and only this DLL has it. -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <Link>
      <AdditionalDependencies>Shlwapi.lib;libMinHook.x64.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='Win32'">
    <Link>
      <AdditionalDependencies>Shlwapi.lib;libMinHook.x86.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>


  <!--
    rc.exe is not cl.exe: it predefines neither _WIN64 nor _M_AMD64, so a
    #ifdef on either is dead in a .rc file no matter which architecture is
    building. That is how the x64 build came to stamp itself
    OriginalFilename=steam_api.dll - the old IS_64BIT macro was never
    defined anywhere either. Pass it in by hand, and verify the stamp with
    `(Get-Item out.dll).VersionInfo` rather than trusting the #ifdef.
  -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ResourceCompile>
      <PreprocessorDefinitions>KRYOTOO_X64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
